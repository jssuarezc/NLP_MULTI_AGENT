# --- Using Local Ollama with Qwen 
LLM_BASE_URL="your_local_ollama_url"
LLM_API_KEY=ollama
LLM_MODEL="your_qwen_model"
LLM_NUM_CTX=8192
LLM_WORKERS=2
MAX_INDEP_SAMPLES=9

# --- Using OpenAI (Comment out the block above and use this) ---
# LLM_BACKEND=openai_compat
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_RPM=300
# LLM_WORKERS=8
